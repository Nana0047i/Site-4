/* ============================================
   style.css — стили для страницы «Обо мне»
   Файл показывает разные возможности CSS,
   но написан просто и с комментариями.
   ============================================ */

/* --- 1. ПЕРЕМЕННЫЕ CSS ---
   Переменные хранят значения, которые можно переиспользовать.
   Меняем в одном месте — обновляется везде. Удобно! */
:root {
  --bg-color:       #FFFFFF;   /* основной фон страницы     */
  --card-bg:        #ffffff;   /* фон карточки               */
  --text-color:     #6600CC;   /* основной цвет текста       */
  --accent-color:   #4a90d9;   /* акцентный цвет (ссылки, h2) */
  --header-bg:      #4C0099;   /* фон шапки                   */
  --footer-bg:      #4C0099;   /* фон подвала                 */
  --border-radius:   32px;      /* скругление углов карточки   */
  --shadow:         0 5px 25px rgba(0, 0, 0, 0.1); /* тень карточки */
}

/* --- 2. СБРОС ОТСТУПОВ ---
   Убираем стандартные отступы у всех элементов,
   чтобы управлять ими самостоятельно. */
* {
  margin: 0;     /* внешние отступы — ноль */
  padding: 0;    /* внутренние отступы — ноль */
  box-sizing: border-box; /* учитываем padding и border в ширине */
}

/* --- 3. ОСНОВНАЯ СТРАНИЦА ---
   body — это вся страница целиком. */
body {
  font-family: 'Segoe UI', Tahoma, sans-serif; /* шрифт */
  background-color: var(--bg-color);           /* фон из переменной */
  color: var(--text-color);                    /* цвет текста       */
  line-height: 1.6;   /* расстояние между строками — читабельнее  */
  min-height: 100vh;  /* минимум — высота экрана, чтобы footer внизу */
  display: flex;       /* flexbox: выстраиваем элементы в колонку   */
  flex-direction: column;
}

/* --- 4. ШАПКА (HEADER) ---
   В шапке находится заголовок первого уровня. */
.header {
  background-color: var(--header-bg);  /* тёмный фон        */
  color: #ffffff;                       /* белый текст       */
  text-align: left;                   /* текст по центру   */
  padding: 20px 20px;                   /* отступы внутри    */
}

.header h1 {
  font-size: 2.5rem;       /* крупный заголовок (rem — от корня) */
  font-weight: 700;        /* жирное начертание                 */
  letter-spacing: 1px;     /* небольшой интервал между буквами    */
}

/* --- 5. ОСНОВНОЙ КОНТЕНТ (MAIN) ---
   Контейнер для карточки. Используем flex для центрирования. */
.content {
  flex: 1;                  /* занимает всё свободное место */
  display: flex ;            /* flexbox                       */
  justify-content: right;  /* по центру по горизонтали      */
  align-items: right;      /* по центру по вертикали        */
  padding: 40px 20px;       /* отступы вокруг                 */
}

/* --- 6. КАРТОЧКА (CARD) ---
   Белый блок с тенью и скруглёнными углами. */
.card {
  background-color: var(--card-bg);       /* белый фон         */
  border-radius: var(--border-radius);    /* скругление углов   */
  box-shadow: var(--shadow);              /* мягкая тень        */
  padding: 40px;                          /* внутренние отступы */
  max-width: 700px;                        /* максимальная ширина */
  width: 100%;                            /* но не шире родителя */
  /* Плавное появление при наведении — демонстрация transition */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* При наведении мышкой карточка чуть приподнимается.
   :hover — псевдокласс, срабатывает при наведении. */
.card:hover {
  transform: translateY(-4px);            /* сдвиг вверх на 4px */
  box-shadow: 1 8px 24px rgba(0, 0, 0, 0.15); /* более заметная тень */
}

/* --- 7. ЗАГОЛОВОК ВТОРОГО УРОВНЯ ---
   Заголовок внутри карточки — с акцентной чертой слева. */
.card h2 {
  color: var(--accent-color);    /* акцентный цвет текста */
  font-size: 1.5rem;             /* средний размер         */
  margin-bottom: 20px;           /* отступ снизу           */
  padding-left: 12px;            /* отступ текста от черты */
  border-left: 4px solid var(--accent-color); /* полоска слева */
}
/* --- 8. АБЗАЦЫ ---
   Расстояние между абзацами — воздух в тексте. */
.card p {
  margin-bottom: 16px;   /* отступ снизу у каждого абзаца */
  font-size: 1rem;        /* обычный размер текста         */
  color: #555555;         /* чуть темнее фона, мягче чёрного */
}

/* Последний абзац без отступа снизу — лишний воздух не нужен.
   :last-child — псевдокласс, выбирает последний элемент. */
.card p:last-child {
  margin-bottom: 0;
}

/* --- 9. ПОДВАЛ (FOOTER) ---
   Нижняя полоса страницы. */
.footer {
  background-color: var(--footer-bg);  /* тёмный фон        */
  color: #ffffff;                       /* белый текст       */
  text-align: left;                   /* текст по центру   */
  padding: 10px;                       /* отступы внутри    */
  font-size: 0.9rem;                   /* чуть мельче текст  */
}

/* --- 10. АДАПТИВНОСТЬ (MEDIA QUERIES) ---
   На узких экранах (телефоны) уменьшаем отступы и шрифт.
   @media — правило, которое применяется при условии. */
@media (max-width: 600px) {
  .header h1 {
    font-size: 1.8rem;  /* заголовок поменьше на телефоне */
  }

  .card {
    padding: 24px;      /* меньше отступы внутри карточки  */
  }

  .card h2 {
    font-size: 1.2rem;  /* подзаголовок поменьше */
  }
}